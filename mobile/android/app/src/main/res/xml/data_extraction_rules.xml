<?xml version="1.0" encoding="utf-8"?>
<!-- Exclusión de Android 12+ para las credenciales de Veyra Music y el estado de escucha privado. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
